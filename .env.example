# ==========================================================================
# AI-OptiCore environment template
# Copy to .env and fill in real values. NEVER commit your real .env file.
# ==========================================================================

# --- Provider credentials (read via os.environ at runtime) ---------------
# OpenAI / OpenAI-compatible endpoints:
OPENAI_API_KEY=

# Ollama local endpoint (no credentials needed, but override base URL if used):
OLLAMA_BASE_URL=http://localhost:11434

# Optional model defaults:
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=llama3.2

# --- Monitoring -----------------------------------------------------------
# Set to 1 to allow prompt/response content in logs. Default: 0 (disabled)
OPTICORE_LOG_PROMPTS=0

# Log level: DEBUG, INFO, WARNING, ERROR. Default: INFO
OPTICORE_LOG_LEVEL=INFO

# --- Benchmark defaults ---------------------------------------------------
# OPTICORE_BENCH_SAMPLES=3
# OPTICORE_BENCH_REPEATS=1